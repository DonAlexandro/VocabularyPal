{
  "nodeModulesDir": "auto",
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno check supabase/functions/telegram-vocab-bot/index.ts",
    "test": "deno test --allow-env --allow-net supabase/functions/telegram-vocab-bot",
    "setup": "deno install --allow-scripts=npm:@google/genai,npm:protobufjs",
    "dev": "deno task setup && deno run --allow-env --allow-net --env-file=.env.local supabase/functions/telegram-vocab-bot/index.ts",
    "dev:supabase": "supabase functions serve telegram-vocab-bot --env-file .env.local --no-verify-jwt",
    "set-webhook": "deno task set-webhook:production",
    "set-webhook:local": "deno run --allow-env --allow-net --allow-run=curl --env-file=.env.local supabase/scripts/set-webhook.ts local",
    "set-webhook:production": "deno run --allow-env --allow-net --allow-run=curl --env-file=.env.prod supabase/scripts/set-webhook.ts production",
    "webhook-info": "deno task webhook-info:local",
    "webhook-info:local": "deno run --allow-env --allow-net --env-file=.env.local supabase/scripts/get-webhook-info.ts",
    "webhook-info:production": "deno run --allow-env --allow-net --env-file=.env.prod supabase/scripts/get-webhook-info.ts"
  },
  "imports": {
    "@notionhq/client": "npm:@notionhq/client@5.23.3",
    "@tanstack/ai": "npm:@tanstack/ai@0.42.0",
    "@tanstack/ai-gemini": "npm:@tanstack/ai-gemini@0.20.1",
    "node-telegram-bot-api": "npm:node-telegram-bot-api@1.2.0",
    "remeda": "npm:remeda@2.39.0",
    "zod": "npm:zod@4.4.3"
  }
}
